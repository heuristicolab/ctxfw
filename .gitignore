# Sovereign Clean Environment — Google Engineering Standards
# Bytecode & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.cache/

# Environments & Dependencies
.venv/
env/
venv/
*.egg-info/
build/
dist/

# Databases & Ephemeral Storage
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Secrets & Configuration
.env
*.env
.env.*

# OS Artifacts (Windows / macOS / Linux)
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini
*.tmp
*.bak
*~
*.swp

# IDE & Editor Files
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# Internal Artifacts & Scratchpads
scratch/
release_assets/
.gtm/
public_export/
org_profile/
profile_readme/

